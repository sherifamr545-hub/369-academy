datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  STUDENT
  PARENT
  TEACHER
  SALES_REP
}

enum AssessmentStatus {
  NOT_COMPLETED
  COMPLETED
}

enum DeliveryMode {
  ONLINE
  OFFLINE
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT_WITHOUT_NOTICE
  EXCUSED_ABSENCE
  CANCELLED_BY_ACADEMY
  RESCHEDULED
}

enum ExcuseStatus {
  PENDING
  APPROVED_BY_TEACHER
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phoneNumber   String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  isActive      boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile        Student?
  parentProfile         Parent?
  teacherProfile        Teacher?
  salesRepProfile       SalesRep?
  auditLogs             AuditLog[]
  notifications         Notification[]
}

model Student {
  id                    String            @id @default(uuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String
  dateOfBirth           DateTime
  assessmentStatus      AssessmentStatus  @default(NOT_COMPLETED)
  salesRepId            String?
  salesRep              SalesRep?         @relation(fields: [salesRepId], references: [id])
  parentStudentLinks    ParentStudent[]
  enrollments           Enrollment[]
  packagePurchases      PackagePurchase[]
  attendance            Attendance[]
  excuseRequests        ExcuseRequest[]
  grades                Grade[]
  homeworkSubmissions   HomeworkSubmission[]
  createdAt             DateTime          @default(now())
}

model Parent {
  id                    String            @id @default(uuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String
  parentStudentLinks    ParentStudent[]
  createdAt             DateTime          @default(now())
}

model ParentStudent {
  id            String    @id @default(uuid())
  parentId      String
  parent        Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship  String

  @@unique([parentId, studentId])
}

model Teacher {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  groups        Group[]
  lessons       Lessons[]
  createdAt     DateTime  @default(now())
}

model SalesRep {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  students      Student[]
  commissions   Commission[]
  createdAt     DateTime  @default(now())
}

model Course {
  id            String    @id @default(uuid())
  name          String
  description   String
  subject       String
  examType      String
  isActive      boolean   @default(true)
  levelsSupported Boolean @default(false)
  groups        Group[]
  enrollments   Enrollment[]
  createdAt     DateTime  @default(now())
}

model Group {
  id              String        @id @default(uuid())
  name            String
  courseId        String
  course          Course        @relation(fields: [courseId], references: [id])
  teacherId       String
  teacher         Teacher       @relation(fields: [teacherId], references: [id])
  deliveryMode    DeliveryMode  @default(ONLINE)
  maxCapacity     Int           @default(5)
  status          String        @default("ACTIVE")
  enrollments     Enrollment[]
  lessons         Lessons[]
  createdAt       DateTime      @default(now())
}

model Enrollment {
  id              String          @id @default(uuid())
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id])
  courseId        String
  course          Course          @relation(fields: [courseId], references: [id])
  groupId         String?
  group           Group?          @relation(fields: [groupId], references: [id])
  status          String          @default("PENDING_PAYMENT")
  packages        PackagePurchase[]
  attendance      Attendance[]
  createdAt       DateTime        @default(now())
}

model PackagePurchase {
  id              String        @id @default(uuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id])
  enrollmentId    String
  enrollment      Enrollment    @relation(fields: [enrollmentId], references: [id])
  totalSessions   Int           @default(10)
  consumedSessions Int          @default(0)
  status          String        @default("QUEUED")
  purchaseDate    DateTime      @default(now())
  payments        Payment[]
  attendance      Attendance[]
}

model Payment {
  id                  String          @id @default(uuid())
  packagePurchaseId   String
  packagePurchase     PackagePurchase @relation(fields: [packagePurchaseId], references: [id])
  amount              Float
  paymentMethod       String
  paymentScreenshot   String
  transactionRef      String?
  status              PaymentStatus   @default(PENDING)
  adminNotes          String?
  rejectionReason     String?
  createdAt           DateTime        @default(now())
  commission          Commission?
}

model Lessons {
  id              String            @id @default(uuid())
  groupId         String
  group           Group             @relation(fields: [groupId], references: [id])
  teacherId       String
  teacher         Teacher           @relation(fields: [teacherId], references: [id])
  date            DateTime
  startTime       String
  endTime         String
  deliveryMode    DeliveryMode      @default(ONLINE)
  meetingLink     String?
  status          String            @default("SCHEDULED")
  attendance      Attendance[]
  excuseRequests  ExcuseRequest[]
  homework        Homework[]
  grades          Grade[]
  createdAt       DateTime          @default(now())
}

model Attendance {
  id                  String            @id @default(uuid())
  lessonId            String
  lesson              Lessons           @relation(fields: [lessonId], references: [id])
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id])
  enrollmentId        String
  enrollment          Enrollment        @relation(fields: [enrollmentId], references: [id])
  packagePurchaseId   String?
  packagePurchase     PackagePurchase?  @relation(fields: [packagePurchaseId], references: [id])
  status              AttendanceStatus  @default(PRESENT)
  isManualOverride    boolean           @default(false)
  createdAt           DateTime          @default(now())
}

model ExcuseRequest {
  id            String        @id @default(uuid())
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id])
  lessonId      String
  lesson        Lessons       @relation(fields: [lessonId], references: [id])
  reason        String
  status        ExcuseStatus  @default(PENDING)
  submittedAt   DateTime      @default(now())
}

model Homework {
  id            String    @id @default(uuid())
  lessonId      String
  lesson        Lessons   @relation(fields: [lessonId], references: [id])
  title         String
  description   String
  dueDate       DateTime
  submissions   HomeworkSubmission[]
  createdAt     DateTime  @default(now())
}

model HomeworkSubmission {
  id           String    @id @default(uuid())
  homeworkId   String
  homework     Homework  @relation(fields: [homeworkId], references: [id])
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  submissionUrl String
  grade        Float?
  feedback     String?
  createdAt    DateTime  @default(now())
}

model Grade {
  id            String    @id @default(uuid())
  lessonId      String
  lesson        Lessons   @relation(fields: [lessonId], references: [id])
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  score         Float
  maxScore      Float     @default(100)
  notes         String?
  createdAt     DateTime  @default(now())
}

model Commission {
  id            String            @id @default(uuid())
  salesRepId    String
  salesRep      SalesRep          @relation(fields: [salesRepId], references: [id])
  paymentId     String            @unique
  payment       Payment           @relation(fields: [paymentId], references: [id])
  amount        Float
  status        CommissionStatus  @default(PENDING)
  createdAt     DateTime          @default(now())
}

model AcademySettings {
  id                  String   @id @default(uuid())
  key                 String   @unique
  value               String
  description         String?
  updatedAt           DateTime @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  isRead      boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  details     String
  ipAddress   String?
  createdAt   DateTime @default(now())
}
